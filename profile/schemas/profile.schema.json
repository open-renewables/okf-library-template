{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "OKF library profile (profile/profile.yaml), SDD I-02",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "profile_version",
    "okf_version",
    "okf_spec_commit",
    "template_version",
    "library",
    "platform",
    "bundle_root",
    "types",
    "vocabularies",
    "tags",
    "path_rules",
    "status",
    "rules",
    "warnings",
    "reports",
    "index"
  ],
  "properties": {
    "profile": { "type": "string", "minLength": 1 },
    "profile_version": { "$ref": "#/$defs/semver" },
    "okf_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "okf_spec_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "template_version": { "$ref": "#/$defs/semver" },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "repository", "site_url"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "repository": { "type": "string" },
        "site_url": { "type": "string" }
      }
    },
    "platform": { "enum": ["github", "git-local"] },
    "maintainers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["emails", "role"],
        "properties": {
          "emails": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "role": { "type": "string", "minLength": 1 }
        }
      }
    },
    "bundle_root": { "type": "string", "minLength": 1 },
    "types": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/type" } },
    "vocabularies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "namespaces"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "namespaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kinds", "values_unique_across_kinds"],
            "properties": {
              "name": { "$ref": "#/$defs/slug" },
              "kinds": { "type": "boolean" },
              "values_unique_across_kinds": { "type": "boolean" }
            }
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": { "pattern": { "type": "string", "minLength": 1 } }
    },
    "path_rules": { "type": "array", "items": { "$ref": "#/$defs/path_rule" } },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "extensions"],
      "properties": {
        "values": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/slug" }, "uniqueItems": true },
        "extensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "trust_tier", "publishing"],
            "properties": {
              "value": { "$ref": "#/$defs/slug" },
              "trust_tier": { "enum": ["unverified", "machine-confirmed", "human-reviewed"] },
              "publishing": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "revision_write",
        "revision_token",
        "write_okf_verified",
        "agent_label",
        "full_review_label",
        "migration_label",
        "stable_requires_human_approval",
        "stable_approvals",
        "allow_recorded_self_approval",
        "require_non_author_approver",
        "stable_requires_citation",
        "reject_unknown_fields",
        "stale_after_default"
      ],
      "properties": {
        "provenance": { "const": "revision-history" },
        "revision_write": { "const": "post-merge" },
        "revision_token": { "enum": ["github-token", "github-app"] },
        "write_okf_verified": { "type": "boolean" },
        "agent_label": { "type": "string", "minLength": 1 },
        "full_review_label": { "type": "string", "minLength": 1 },
        "migration_label": { "type": "string", "minLength": 1 },
        "stable_requires_human_approval": { "type": "boolean" },
        "stable_approvals": { "type": "integer", "minimum": 1 },
        "allow_recorded_self_approval": { "type": "boolean" },
        "require_non_author_approver": { "type": "boolean" },
        "stable_requires_citation": { "type": "boolean" },
        "reject_unknown_fields": { "type": "boolean" },
        "stale_after_default": { "type": "string", "pattern": "^P(?=[0-9])([0-9]+Y)?([0-9]+M)?([0-9]+W)?([0-9]+D)?$" }
      }
    },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": { "id": { "$ref": "#/$defs/slug" }, "kind": { "type": "string" } }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["show_status", "show_tier", "max_concepts_per_directory"],
      "properties": {
        "show_status": { "type": "boolean" },
        "show_tier": { "type": "boolean" },
        "max_concepts_per_directory": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$" },
    "type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uid_prefix", "schema"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "uid_prefix": { "type": "string", "pattern": "^[A-Z]{2,5}$" },
        "schema": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "body": { "$ref": "#/$defs/body" }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title_heading", "order", "empty_placeholder", "sections"],
      "properties": {
        "title_heading": { "enum": ["h1_equals_title", "none"] },
        "order": { "enum": ["strict", "any"] },
        "empty_placeholder": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "required"],
            "properties": {
              "heading": { "type": "string", "minLength": 1 },
              "required": { "type": "boolean" },
              "format": { "$ref": "#/$defs/slug" },
              "managed_by": { "const": "ci" }
            }
          }
        }
      }
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "path_rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "segment"],
          "properties": {
            "kind": { "const": "tag_equals_segment" },
            "namespace": { "$ref": "#/$defs/slug" },
            "segment": { "type": "integer", "minimum": 0 },
            "types": { "$ref": "#/$defs/applies_to" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "min", "max"],
          "properties": {
            "kind": { "const": "tag_count" },
            "namespace": { "$ref": "#/$defs/slug" },
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 1 },
            "types": { "$ref": "#/$defs/applies_to" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "segment", "vocabulary", "kind_value"],
          "properties": {
            "kind": { "const": "tag_required_if_segment_kind" },
            "namespace": { "$ref": "#/$defs/slug" },
            "segment": { "type": "integer", "minimum": 0 },
            "vocabulary": { "$ref": "#/$defs/slug" },
            "kind_value": { "type": "string", "minLength": 1 },
            "types": { "$ref": "#/$defs/applies_to" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "namespace", "segments"],
          "properties": {
            "kind": { "const": "tag_not_equal_segment" },
            "namespace": { "$ref": "#/$defs/slug" },
            "segments": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
            "types": { "$ref": "#/$defs/applies_to" }
          }
        }
      ]
    },
    "warning": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "level", "enabled", "namespace", "segments"],
          "properties": {
            "id": { "$ref": "#/$defs/slug" },
            "kind": { "const": "tag_not_equal_segment" },
            "level": { "enum": ["low", "medium"] },
            "enabled": { "type": "boolean" },
            "namespace": { "$ref": "#/$defs/slug" },
            "segments": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "level", "enabled"],
          "properties": {
            "id": { "$ref": "#/$defs/slug" },
            "kind": { "const": "agent_label_missing" },
            "level": { "enum": ["low", "medium"] },
            "enabled": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "level", "enabled", "sections"],
          "properties": {
            "id": { "$ref": "#/$defs/slug" },
            "kind": { "const": "stable_section_nonempty" },
            "level": { "enum": ["low", "medium"] },
            "enabled": { "type": "boolean" },
            "sections": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "level", "enabled", "max"],
          "properties": {
            "id": { "$ref": "#/$defs/slug" },
            "kind": { "const": "directory_size" },
            "level": { "enum": ["low", "medium"] },
            "enabled": { "type": "boolean" },
            "max": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    }
  }
}
