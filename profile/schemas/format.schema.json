{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "format.schema.json",
  "title": "Section format (frontmatter of profile/formats/<format>.md), SDD I-04",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "item"],
  "properties": {
    "format": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": { "type": "string", "minLength": 1 },
        "enums": {
          "type": "object",
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        },
        "vocab": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    },
    "children": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "required"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "enum": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    }
  }
}
